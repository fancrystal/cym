[Unit]
Description=CYM local commerce API
After=network.target mysqld.service

[Service]
Type=simple
User=cym
Group=cym
WorkingDirectory=/srv/cym/current/packages/backend
EnvironmentFile=/srv/cym/shared/backend.env
ExecStart=/usr/bin/node /srv/cym/current/packages/backend/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
